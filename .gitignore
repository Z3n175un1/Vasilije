*.log
.DS_Store
# =========================================================
# CREDENCIALES
#
# `.env.*` cubre todas las variantes (local, produccion, staging...).
# La excepcion mantiene versionable solo la plantilla, que no lleva claves.
# =========================================================
.env
.env.*
!.env.example
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules

# =========================================================
# LOCKFILES
#
# `pnpm-lock.yaml` SI se versiona, y es deliberado: es lo que hace que
# `pnpm install --frozen-lockfile` pueda fijar versiones exactas en el build
# de Docker y en CI. Ignorarlo hacia que un clone limpio no lo tuviera y el
# build fallara con "failed to compute cache key: /pnpm-lock.yaml: not
# found". No contiene credenciales: solo nombres y versiones.
#
# `package-lock.json` se sigue ignorando porque este proyecto usa pnpm; tener
# los dos lockfiles a la vez es justamente lo que genera esos conflictos.
# =========================================================
/package-lock.json
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Respaldos de base de datos: pueden contener datos personales.
storage/app/respaldos/

# Entorno de pruebas: contiene credenciales de la BD de test
.env.testing
