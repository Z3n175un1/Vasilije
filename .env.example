###############################################################
#  DS TRANSPORTE S.R.L  --  variables de entorno
#  Copiar a .env y completar. NUNCA versionar .env ni escribir
#  credenciales reales en config/*.php
###############################################################

APP_NAME="DS TRANSPORTE S.R.L"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_BO
APP_TIMEZONE=America/La_Paz

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################
#  BASE DE DATOS (PostgreSQL, esquema "global")
###############################################################
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=NewTransporte
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=global
DB_SSLMODE=prefer


###############################################################
#  SESION / CACHE / COLAS
###############################################################
SESSION_DRIVER=file
SESSION_LIFETIME=7200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################
#  MAIL
###############################################################
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@dstransporte.local"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################
#  SEGURIDAD
###############################################################
# Maximo de intentos de login antes del bloqueo temporal
AUTH_MAX_INTENTOS=5
# Minutos de bloqueo tras superar los intentos
AUTH_BLOQUEO_MINUTOS=15
# Ventana para el calculo de "intentos fallidos"
AUTH_INTENTOS_DECAY_MINUTOS=30

VITE_APP_NAME="${APP_NAME}"
